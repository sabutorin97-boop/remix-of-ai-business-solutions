# AI-чат-виджет «Макс» (kie.ai)
KIE_API_KEY=

# Порт (Timeweb Cloud Apps пробрасывает свой)
PORT=3000

# Опционально — Яндекс.Метрика (нужна ещё и на этапе сборки, VITE_*)
VITE_YANDEX_METRIKA_ID=

# Telegram-бот, принимающий заявки с сайта
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# api.telegram.org недоступен напрямую с IP Timeweb App Platform (сетевой
# блок). Указать URL Cloudflare Worker-релея, если задеплоен, иначе не
# заполнять — тогда используется https://api.telegram.org.
TELEGRAM_API_BASE=

# Хранилище заявок — Timeweb S3 (приватный бакет, данные физически в РФ)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# /admin — простой логин/пароль
SITE_BASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Партнёрский Telegram-бот (кабинет партнёра, /api/telegram/partner) ---
# Токен отдельного бота из @BotFather. Если не задан, бот работает на том же
# токене, что и TELEGRAM_BOT_TOKEN (один бот на заявки и на партнёров).
TELEGRAM_PARTNER_BOT_TOKEN=
# Секрет вебхука: без него роут отвечает 503 и апдейты не принимаются.
# Любая длинная случайная строка, она же уходит в setWebhook.
TELEGRAM_PARTNER_WEBHOOK_SECRET=
# Общий код доступа. Нужен, только если не пользоваться личными приглашениями
# (/invite в боте). Если пусто и приглашений нет — в бот пускают всех подряд.
PARTNER_BOT_ACCESS_CODE=
# Username партнёрского бота для ссылок-приглашений (по умолчанию
# AIProfigrupPartner_bot).
PARTNER_BOT_USERNAME=
# Ставки комиссии в процентах. Холодный лид — только ФИО и контакты из
# заявки; тёплый — проведена консультация и заполнен бриф. Действующие ставки
# (15 и 30) зашиты в src/lib/partner-training.ts; эти переменные нужны, только
# если ставки поменяются и не хочется править код.
# Правило «выплата после оплаты заказа заказчиком» не настраивается
# (PAYOUT_RULE там же).
PARTNER_COMMISSION_COLD_PERCENT=
PARTNER_COMMISSION_WARM_PERCENT=
PARTNER_MANAGER_CONTACT=
